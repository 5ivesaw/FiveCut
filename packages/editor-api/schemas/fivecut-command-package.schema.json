{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fivecut.app/schemas/v1/fivecut-command-package.schema.json",
  "title": "FiveCut Command Package",
  "description": "Ordered, transaction-safe operations produced by an AI chat or local agent.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "packageId", "operations"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "fivecut-command-package" },
    "version": { "const": "1.0.0" },
    "packageId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "description": { "type": "string", "maxLength": 4000 },
    "baseProjectSha256": {
      "description": "Reject the package if the target project has changed.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "onMissingAsset": {
      "enum": ["fail", "skip-optional"],
      "default": "fail"
    },
    "dryRunFirst": { "type": "boolean", "default": true },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "op": {
          "enum": [
            "asset.add",
            "asset.remove",
            "track.add",
            "track.remove",
            "track.update",
            "clip.add",
            "clip.remove",
            "clip.update",
            "marker.add",
            "marker.remove",
            "project.update",
            "export.update"
          ]
        },
        "targetId": { "$ref": "#/$defs/id" },
        "trackId": { "$ref": "#/$defs/id" },
        "value": {
          "description": "Object validated against the project schema after each operation.",
          "type": "object"
        },
        "patch": {
          "description": "Shallow field patch; id, format, and version are immutable.",
          "type": "object"
        },
        "preconditions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "exists": { "type": "boolean" },
            "fieldEquals": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "enum": ["asset.add", "track.add", "clip.add", "marker.add"]
              }
            }
          },
          "then": { "required": ["value"] }
        },
        {
          "if": {
            "properties": { "op": { "const": "clip.add" } }
          },
          "then": { "required": ["trackId"] }
        },
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "asset.remove",
                  "track.remove",
                  "track.update",
                  "clip.remove",
                  "clip.update",
                  "marker.remove"
                ]
              }
            }
          },
          "then": { "required": ["targetId"] }
        },
        {
          "if": {
            "properties": {
              "op": {
                "enum": ["track.update", "clip.update", "project.update", "export.update"]
              }
            }
          },
          "then": { "required": ["patch"] }
        }
      ]
    }
  }
}
