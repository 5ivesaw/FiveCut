#!/usr/bin/env python3
"""Small Linux desktop shell for the usable OpenCut web editor."""

from __future__ import annotations

import os
import sys
from html import escape
from pathlib import Path

APP_ID = "app.opencut.OpenCut"
APP_NAME = "OpenCut"
APP_URL = "https://opencut.app/projects"

# A user-local install can bundle the tiny GI metadata files while reusing the
# WebKit and GTK libraries already provided by the operating system.
_data_home = Path(
    os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share")
)
_typelib_dir = _data_home / "opencut" / "girepository-1.0"
if _typelib_dir.is_dir():
    _existing_typelib_path = os.environ.get("GI_TYPELIB_PATH")
    os.environ["GI_TYPELIB_PATH"] = (
        f"{_typelib_dir}:{_existing_typelib_path}"
        if _existing_typelib_path
        else str(_typelib_dir)
    )


def open_in_firefox() -> None:
    """Fallback for systems without the WebKit Python bindings."""
    try:
        os.execvp("firefox", ["firefox", "--new-window", APP_URL])
    except FileNotFoundError:
        print(
            "OpenCut needs either the WebKit GTK Python bindings or Firefox.",
            file=sys.stderr,
        )
        raise SystemExit(1)


if "--browser" in sys.argv:
    open_in_firefox()

try:
    import gi

    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("WebKit2", "4.1")
    from gi.repository import Gdk, Gio, GLib, Gtk, WebKit2
except (ImportError, ValueError):
    open_in_firefox()


class OpenCutApplication(Gtk.Application):
    def __init__(self) -> None:
        super().__init__(application_id=APP_ID)
        self.window: Gtk.ApplicationWindow | None = None
        self.webview: WebKit2.WebView | None = None

    def do_activate(self) -> None:
        if self.window is not None:
            self.window.present()
            return

        data_home = Path(
            os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share")
        )
        cache_home = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
        data_dir = data_home / "opencut" / "web-data"
        cache_dir = cache_home / "opencut"
        data_dir.mkdir(parents=True, exist_ok=True)
        cache_dir.mkdir(parents=True, exist_ok=True)

        data_manager = WebKit2.WebsiteDataManager(
            base_data_directory=str(data_dir),
            base_cache_directory=str(cache_dir),
        )
        context = WebKit2.WebContext.new_with_website_data_manager(data_manager)
        context.set_cache_model(WebKit2.CacheModel.WEB_BROWSER)
        context.connect("download-started", self._download_started)

        self.webview = WebKit2.WebView.new_with_context(context)
        self.webview.connect("size-allocate", self._fit_desktop_viewport)
        settings = self.webview.get_settings()
        self._enable_if_available(settings, "enable-webgl")
        self._enable_if_available(settings, "enable-webaudio")
        self._enable_if_available(settings, "enable-media-stream")
        self._enable_if_available(settings, "enable-mediasource")
        self._enable_if_available(settings, "enable-fullscreen")
        self._enable_if_available(settings, "javascript-can-access-clipboard")
        self._enable_if_available(settings, "allow-modal-dialogs")
        self._enable_if_available(settings, "enable-smooth-scrolling")
        self._enable_if_available(
            settings, "media-playback-requires-user-gesture", False
        )

        self.window = Gtk.ApplicationWindow(application=self)
        self.window.set_title(APP_NAME)
        self.window.set_default_size(1280, 800)
        self.window.set_icon_name("opencut")
        self.window.add(self.webview)
        self.window.connect("key-press-event", self._key_press)

        self.webview.connect("notify::title", self._title_changed)
        self.webview.connect("load-failed", self._load_failed)
        self.webview.connect("web-process-terminated", self._web_process_terminated)
        self.webview.load_uri(APP_URL)

        self.window.show_all()
        self.window.maximize()

    @staticmethod
    def _fit_desktop_viewport(
        webview: WebKit2.WebView, allocation: Gdk.Rectangle
    ) -> None:
        # OpenCut currently guards its editor behind a desktop-width breakpoint.
        # Fractional Wayland scaling can expose a 1366 px panel as only ~910 CSS
        # pixels. Zoom out only as far as needed to preserve the full editor.
        minimum_editor_width = 1_100
        zoom = max(0.75, min(1.0, allocation.width / minimum_editor_width))
        if abs(webview.get_zoom_level() - zoom) >= 0.01:
            webview.set_zoom_level(zoom)

    @staticmethod
    def _enable_if_available(
        settings: WebKit2.Settings, property_name: str, value: bool = True
    ) -> None:
        if settings.find_property(property_name) is not None:
            settings.set_property(property_name, value)

    def _title_changed(self, webview: WebKit2.WebView, _param: object) -> None:
        if self.window is not None:
            title = webview.get_title()
            self.window.set_title(title if title else APP_NAME)

    def _key_press(
        self, _window: Gtk.ApplicationWindow, event: Gdk.EventKey
    ) -> bool:
        if self.webview is None or self.window is None:
            return False

        state = event.state
        control = bool(state & Gdk.ModifierType.CONTROL_MASK)
        alt = bool(state & Gdk.ModifierType.MOD1_MASK)

        if event.keyval == Gdk.KEY_F5 or (
            control and event.keyval in (Gdk.KEY_r, Gdk.KEY_R)
        ):
            self.webview.reload()
            return True
        if alt and event.keyval == Gdk.KEY_Left and self.webview.can_go_back():
            self.webview.go_back()
            return True
        if alt and event.keyval == Gdk.KEY_Right and self.webview.can_go_forward():
            self.webview.go_forward()
            return True
        if event.keyval == Gdk.KEY_F11:
            gdk_window = self.window.get_window()
            is_fullscreen = (
                gdk_window is not None
                and bool(gdk_window.get_state() & Gdk.WindowState.FULLSCREEN)
            )
            if is_fullscreen:
                self.window.unfullscreen()
            else:
                self.window.fullscreen()
            return True
        return False

    def _load_failed(
        self,
        webview: WebKit2.WebView,
        _load_event: WebKit2.LoadEvent,
        failing_uri: str,
        error: GLib.Error,
    ) -> bool:
        if error.matches(WebKit2.NetworkError.quark(), WebKit2.NetworkError.CANCELLED):
            return False

        message = escape(error.message)
        uri = escape(failing_uri)
        webview.load_html(
            f"""<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="color-scheme" content="light dark">
  <title>OpenCut</title>
  <style>
    body {{ font: 16px system-ui; display: grid; place-items: center;
            min-height: 90vh; margin: 0; }}
    main {{ max-width: 34rem; padding: 2rem; text-align: center; }}
    button {{ font: inherit; padding: .65rem 1rem; cursor: pointer; }}
    small {{ display: block; margin-top: 1rem; opacity: .65;
             overflow-wrap: anywhere; }}
  </style>
</head>
<body>
  <main>
    <h1>OpenCut could not connect</h1>
    <p>Check your internet connection, then retry.</p>
    <button onclick="location.href='{APP_URL}'">Retry</button>
    <small>{uri}<br>{message}</small>
  </main>
</body>
</html>""",
            APP_URL,
        )
        return True

    def _web_process_terminated(
        self, webview: WebKit2.WebView, _reason: object
    ) -> bool:
        GLib.timeout_add_seconds(1, self._reload_after_crash, webview)
        return True

    @staticmethod
    def _reload_after_crash(webview: WebKit2.WebView) -> bool:
        webview.reload()
        return GLib.SOURCE_REMOVE

    def _download_started(
        self, _context: WebKit2.WebContext, download: WebKit2.Download
    ) -> None:
        download.connect("decide-destination", self._choose_download_destination)
        download.connect("finished", self._download_finished)

    @staticmethod
    def _choose_download_destination(
        download: WebKit2.Download, suggested_filename: str
    ) -> bool:
        downloads = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOWNLOAD)
        download_dir = Path(downloads) if downloads else Path.home() / "Downloads"
        download_dir.mkdir(parents=True, exist_ok=True)

        safe_name = Path(suggested_filename or "opencut-export").name
        destination = download_dir / safe_name
        stem, suffix = destination.stem, destination.suffix
        counter = 1
        while destination.exists():
            destination = download_dir / f"{stem} ({counter}){suffix}"
            counter += 1

        download.set_destination(destination.as_uri())
        return True

    def _download_finished(self, download: WebKit2.Download) -> None:
        destination = download.get_destination()
        if destination is None:
            return
        path = Gio.File.new_for_uri(destination).get_path()
        notification = Gio.Notification.new("OpenCut export finished")
        notification.set_body(f"Saved to {path}" if path else "Saved to Downloads")
        self.send_notification("opencut-download", notification)


def main() -> int:
    GLib.set_application_name(APP_NAME)
    GLib.set_prgname("opencut")
    return OpenCutApplication().run([sys.argv[0]])


if __name__ == "__main__":
    raise SystemExit(main())
