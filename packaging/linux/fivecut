#!/bin/sh
set -eu

bundle_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
electron="$bundle_dir/runtime/electron"
app_dir="$bundle_dir/app"

if [ ! -x "$electron" ]; then
    printf 'FiveCut runtime is missing: %s\n' "$electron" >&2
    exit 1
fi
if [ ! -f "$app_dir/package.json" ]; then
    printf 'FiveCut application files are missing: %s\n' "$app_dir" >&2
    exit 1
fi

sandbox_flag=--disable-setuid-sandbox

# Portable archives cannot ship a root-owned setuid helper. Prefer Chromium's
# unprivileged user-namespace sandbox, but Ubuntu 23.10+ blocks it for
# unconfined portable binaries through AppArmor. Use the compatibility fallback
# only when the host explicitly disables that sandbox (or when run as root).
if [ "$(id -u)" -eq 0 ]; then
    sandbox_flag=--no-sandbox
elif [ -r /proc/sys/kernel/apparmor_restrict_unprivileged_userns ] &&
     [ "$(sed -n '1p' /proc/sys/kernel/apparmor_restrict_unprivileged_userns)" = "1" ]; then
    sandbox_flag=--no-sandbox
elif [ -r /proc/sys/kernel/unprivileged_userns_clone ] &&
     [ "$(sed -n '1p' /proc/sys/kernel/unprivileged_userns_clone)" = "0" ]; then
    sandbox_flag=--no-sandbox
fi

exec "$electron" "$sandbox_flag" "$app_dir" "$@"
